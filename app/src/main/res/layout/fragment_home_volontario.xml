<?xml version="1.0" encoding="utf-8"?>
<!-- Contenitore della sezione Volontario. Come l'Anziano: fitsSystemWindows
     fa riservare al framework lo spazio delle barre di sistema già durante il
     layout, così la barra in alto ha SEMPRE l'altezza giusta anche sulla prima
     schermata. Lo sfondo blu riempie quello spazio (sembra il prolungamento
     della Toolbar e della bottom nav). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/care_primary"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/volontarioToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="@color/care_primary"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
        app:titleTextColor="@color/care_on_primary" />

    <!-- NavHost annidato. Niente app:defaultNavHost: il tasto Indietro di
         questa sezione lo gestiamo con un callback esplicito nel fragment. -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/volontarioNavHostFragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:navGraph="@navigation/nav_graph_volontario" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/volontarioBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/care_primary"
        app:elevation="8dp"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/bottom_nav_item_tint"
        app:itemTextColor="@color/bottom_nav_item_tint"
        app:itemActiveIndicatorStyle="@style/CareConnect.BottomNav.ActiveIndicator"
        app:menu="@menu/bottom_nav_volontario" />

</LinearLayout>