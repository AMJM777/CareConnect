<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/care_background"
        android:padding="@dimen/screen_padding">

        <TextView
            android:id="@+id/titoloText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cosa vuoi fare?"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            android:textColor="@color/care_on_surface"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- AZIONE QUOTIDIANA: card arancione pastello, testo scuro. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/nuovaRichiestaButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/care_accent_container"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/care_accent"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/titoloText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/spacing_large">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_input_add"
                    android:contentDescription="@null"
                    app:tint="@color/care_accent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_medium"
                    android:text="Crea una nuova richiesta"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold"
                    android:textColor="@color/care_accent" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ZONA EMERGENZA: staccata dall'azione quotidiana da uno spazio netto
             (48dp), ma non "buttata" in fondo: scorre subito dopo, così niente
             vuoto centrale. -->
        <TextView
            android:id="@+id/emergenzaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="In caso di emergenza"
            android:textSize="@dimen/text_size_body"
            android:textColor="@color/care_on_surface_variant"
            app:layout_constraintTop_toBottomOf="@id/nuovaRichiestaButton"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- SOS: card rossa contenuta. care_sos riservato ESCLUSIVAMENTE a questo. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/sosButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/care_sos"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/emergenzaLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/spacing_medium"
                android:paddingBottom="@dimen/spacing_medium"
                android:text="SOS"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/care_on_primary"
                android:gravity="center" />

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>