<?xml version="1.0" encoding="utf-8"?>
<!-- home dell'anziano: banner richieste in corso, form nuova richiesta, sos -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- vista scorrevole: evita che la tastiera copra i campi in edge-to-edge -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/care_background"
        android:clipToPadding="false"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/screen_padding">

            <!-- banner richieste in corso: nascosto finché il fragment non ne trova -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/bannerInCorso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                app:cardBackgroundColor="@color/care_accent_container"
                app:cardCornerRadius="@dimen/button_corner_radius"
                app:cardElevation="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/spacing_medium">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_info"
                        android:contentDescription="@null"
                        app:tint="@color/care_primary" />

                    <TextView
                        android:id="@+id/bannerInCorsoText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:text="Hai richieste in corso"
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/care_primary_dark" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- card che raccoglie il form di creazione -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/formCard"
                style="@style/CareConnect.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                app:layout_constraintTop_toBottomOf="@id/bannerInCorso"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- titolo del form -->
                    <TextView
                        android:id="@+id/titoloText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Di cosa hai bisogno?"
                        android:textSize="@dimen/text_size_title"
                        android:textStyle="bold"
                        android:textColor="@color/care_primary" />

                    <!-- scelta del tipo di aiuto: pillole SEPARATE (non un toggle-group
                         unito). La selezione singola è gestita nel Fragment. -->
                    <LinearLayout
                        android:id="@+id/tipoContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tipoSpesa"
                            style="@style/CareConnect.OptionToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="Spesa"
                            app:icon="@drawable/ic_spesa" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tipoBolletta"
                            style="@style/CareConnect.OptionToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:checkable="true"
                            android:text="Bolletta"
                            app:icon="@drawable/ic_bolletta" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tipoAssistenzaDigitale"
                            style="@style/CareConnect.OptionToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:checkable="true"
                            android:text="Assistenza digitale"
                            app:icon="@drawable/ic_assistenza_digitale" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tipoAltro"
                            style="@style/CareConnect.OptionToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:checkable="true"
                            android:text="Altro"
                            app:icon="@drawable/ic_altro" />

                    </LinearLayout>

                    <!-- campo libero, visibile solo con la scelta "altro" -->
                    <EditText
                        android:id="@+id/altroInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:minHeight="@dimen/touch_target_min"
                        android:background="@drawable/bg_input_outline"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp"
                        android:hint="Specifica (facoltativo)"
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/care_on_surface"
                        android:textColorHint="@color/care_on_surface_variant"
                        android:visibility="gone" />

                    <!-- dettagli della richiesta -->
                    <EditText
                        android:id="@+id/descrizioneInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_large"
                        android:background="@drawable/bg_input_outline"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp"
                        android:hint="Descrivi di cosa hai bisogno"
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/care_on_surface"
                        android:textColorHint="@color/care_on_surface_variant"
                        android:minLines="3"
                        android:gravity="top|start" />

                    <!-- messaggio di errore di validazione -->
                    <TextView
                        android:id="@+id/errorText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:textColor="@color/care_error"
                        android:textSize="@dimen/text_size_body"
                        android:visibility="gone" />

                    <!-- invio della richiesta: azione primaria prugna -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/inviaButton"
                        style="@style/CareConnect.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/spacing_large"
                        android:text="Invia richiesta" />

                    <!-- rotella durante l'invio -->
                    <ProgressBar
                        android:id="@+id/loadingIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- etichetta della zona emergenza -->
            <TextView
                android:id="@+id/emergenzaLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:text="In caso di emergenza"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/care_on_surface_variant"
                app:layout_constraintTop_toBottomOf="@id/formCard"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- sos: care_sos riservato solo a questo -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/sosButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/care_sos"
                app:cardCornerRadius="@dimen/button_corner_radius"
                app:cardElevation="2dp"
                app:layout_constraintTop_toBottomOf="@id/emergenzaLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:minHeight="64dp"
                    android:paddingHorizontal="@dimen/spacing_large"
                    android:paddingTop="@dimen/spacing_medium"
                    android:paddingBottom="@dimen/spacing_medium">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_emergenza"
                        android:contentDescription="@null"
                        app:tint="@color/care_on_sos" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SOS"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="@color/care_on_sos" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chiedi aiuto ora"
                            android:textSize="@dimen/text_size_body"
                            android:textColor="@color/care_on_sos" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- suggerimento: lo scuotimento e' il secondo modo per lanciare l'sos -->
            <TextView
                android:id="@+id/scuotiHintText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:gravity="center"
                android:text="Oppure scuoti il telefono per chiedere aiuto"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/care_on_surface_variant"
                app:layout_constraintTop_toBottomOf="@id/sosButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</layout>
