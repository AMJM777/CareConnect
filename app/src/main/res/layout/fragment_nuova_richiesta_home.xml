<?xml version="1.0" encoding="utf-8"?>
<!-- Home dell'Anziano: banner "richiesta in corso" + form nuova richiesta + SOS. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- vista scorrevole: evita che la tastiera copra i campi in edge-to-edge -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/care_background"
        android:clipToPadding="false"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/screen_padding">

            <!-- BANNER "richiesta in corso": nascosto di default (visibility gone)
                 Il Fragment lo mostra se ci sono richieste attive.
                 Tap -> tab "Le mie richieste". -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/bannerInCorso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                app:cardBackgroundColor="@color/care_primary_container"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/spacing_medium">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@android:drawable/ic_menu_recent_history"
                        android:contentDescription="@null"
                        app:tint="@color/care_primary" />

                    <TextView
                        android:id="@+id/bannerInCorsoText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:text="Hai richieste in corso"
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/care_on_surface" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- titolo del form -->
            <TextView
                android:id="@+id/titoloText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="Di cosa hai bisogno?"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                android:textColor="@color/care_on_surface"
                app:layout_constraintTop_toBottomOf="@id/bannerInCorso"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- gruppo di opzioni predefinite per il tipo di aiuto -->
            <RadioGroup
                android:id="@+id/tipoRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                app:layout_constraintTop_toBottomOf="@id/titoloText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <RadioButton
                    android:id="@+id/tipoSpesaRadio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="Spesa"
                    android:textSize="@dimen/text_size_body" />

                <RadioButton
                    android:id="@+id/tipoBollettaRadio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="Bolletta"
                    android:textSize="@dimen/text_size_body" />

                <RadioButton
                    android:id="@+id/tipoAssistenzaDigitaleRadio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="Assistenza digitale"
                    android:textSize="@dimen/text_size_body" />

                <RadioButton
                    android:id="@+id/tipoAltroRadio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="Altro"
                    android:textSize="@dimen/text_size_body" />

            </RadioGroup>

            <!-- campo aggiuntivo, visibile solo se si seleziona "Altro" -->
            <EditText
                android:id="@+id/altroInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:minHeight="@dimen/touch_target_min"
                android:hint="Specifica (facoltativo)"
                android:textSize="@dimen/text_size_body"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tipoRadioGroup"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- descrizione dei dettagli della richiesta -->
            <EditText
                android:id="@+id/descrizioneInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:hint="Descrivi di cosa hai bisogno"
                android:textSize="@dimen/text_size_body"
                android:minLines="3"
                android:gravity="top|start"
                app:layout_constraintTop_toBottomOf="@id/altroInput"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- messaggio di errore in caso di validazione fallita -->
            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:textColor="@color/care_error"
                android:textSize="@dimen/text_size_body"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/descrizioneInput"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- bottone per inviare la richiesta -->
            <Button
                android:id="@+id/inviaButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="Invia richiesta"
                android:textSize="@dimen/text_size_button"
                android:backgroundTint="@color/care_primary"
                android:textColor="@color/care_on_primary"
                app:layout_constraintTop_toBottomOf="@id/errorText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- rotella mostrata durante l'invio -->
            <ProgressBar
                android:id="@+id/loadingIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/inviaButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ZONA EMERGENZA -->
            <TextView
                android:id="@+id/emergenzaLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:text="In caso di emergenza"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/care_on_surface_variant"
                app:layout_constraintTop_toBottomOf="@id/loadingIndicator"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- SOS: care_sos riservato ESCLUSIVAMENTE a questo. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/sosButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/care_sos"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:layout_constraintTop_toBottomOf="@id/emergenzaLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:paddingTop="@dimen/spacing_medium"
                    android:paddingBottom="@dimen/spacing_medium"
                    android:text="SOS"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/care_on_sos"
                    android:gravity="center" />

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</layout>