<?xml version="1.0" encoding="utf-8"?>
<!-- contenitore radice obbligatorio per abilitare il data binding -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- card della richiesta presa in carico dal volontario con margini di distanziamento -->
    <com.google.android.material.card.MaterialCardView
        style="@style/CareConnect.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_small"
        android:layout_marginEnd="@dimen/spacing_small"
        android:layout_marginTop="@dimen/spacing_small">

        <!-- layout interno che organizza verticalmente i dettagli e le azioni -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tipoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                android:textColor="@color/care_on_surface"
                tools:text="Spesa" />

            <TextView
                android:id="@+id/descrizioneText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/care_on_surface"
                tools:text="Ho bisogno di aiuto per fare la spesa settimanale" />

            <!-- nome dell'autore della richiesta, visibile al volontario solo dopo aver accettato l'incarico -->
            <TextView
                android:id="@+id/autoreNomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                android:textColor="@color/care_primary_dark"
                tools:text="Da: Maria Rossi" />

            <!-- indirizzo dell'autore per permettere al volontario di raggiungerlo fisicamente -->
            <TextView
                android:id="@+id/autoreIndirizzoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/care_on_surface"
                tools:text="Via Roma 12, Milano" />

            <!-- indicatore a pillola per mostrare lo stato attuale della richiesta -->
            <TextView
                android:id="@+id/statoText"
                style="@style/CareConnect.StatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                tools:text="Presa in carico" />

            <TextView
                android:id="@+id/dataText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/care_on_surface_variant"
                tools:text="04/07/2026 10:15" />

            <!-- contenitore orizzontale per i bottoni di gestione della richiesta -->
            <LinearLayout
                android:id="@+id/azioniContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/spacing_small">

                <!-- bottone per segnalare di aver concluso positivamente l'attività -->
                <Button
                    android:id="@+id/completaButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Segna come completata"
                    android:textColor="@color/care_primary_dark" />

                <!-- bottone per rinunciare all'incarico e far tornare la richiesta tra quelle disponibili -->
                <Button
                    android:id="@+id/rilasciaButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rilascia"
                    android:textColor="@color/care_error" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>
</layout>