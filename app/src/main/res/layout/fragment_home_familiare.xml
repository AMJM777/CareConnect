<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/care_background"
        android:padding="@dimen/screen_padding">

        <!-- Stato: caricamento iniziale (verifica se già collegato) -->
        <ProgressBar
            android:id="@+id/caricamentoProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Stato: non ancora collegato a nessun anziano -->
        <TextView
            android:id="@+id/collegaTitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Collegati al tuo assistito"
            android:textSize="@dimen/text_size_title"
            android:textColor="@color/care_on_surface"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/collegaSubtitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="Chiedi il codice invito alla persona che segui e inseriscilo qui sotto."
            android:textSize="@dimen/text_size_body"
            android:textColor="@color/care_on_surface"
            app:layout_constraintTop_toBottomOf="@id/collegaTitleText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/codiceInvitoEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:hint="Codice invito"
            android:inputType="textCapCharacters"
            android:imeOptions="actionDone"
            android:maxLines="1"
            app:layout_constraintTop_toBottomOf="@id/collegaSubtitleText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/erroreCollegamentoText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:textColor="@color/care_error"
            android:visibility="gone"
            tools:text="Codice non valido"
            app:layout_constraintTop_toBottomOf="@id/codiceInvitoEditText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/collegatiButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="Collegati"
            app:layout_constraintTop_toBottomOf="@id/erroreCollegamentoText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ProgressBar
            android:id="@+id/collegamentoProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/collegatiButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/collegaGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="collegaTitleText,collegaSubtitleText,codiceInvitoEditText,collegatiButton" />

        <!-- Stato: già collegato. Contenitore per il grafo annidato
             (Attività/Profilo), agganciato a runtime da HomeFamiliareFragment. -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/familiareNavHostContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/familiareBottomNav" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/familiareBottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menu="@menu/bottom_nav_familiare"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/collegatoGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="familiareNavHostContainer,familiareBottomNav" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>