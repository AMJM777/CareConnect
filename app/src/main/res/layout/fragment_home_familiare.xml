<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- fitsSystemWindows fa riservare al framework lo spazio delle barre di
         sistema già durante il layout (robusto e adattivo). Lo sfondo di
         default resta chiaro: così lo stato "non collegato" (il form) è bianco
         e pulito. Da collegati, HomeFamiliareFragment colora la root di blu,
         così le strisce in alto/basso diventano blu come nelle altre sezioni. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/care_background"
        android:fitsSystemWindows="true">

        <!-- Toolbar del ruolo. Fa parte del collegatoGroup: compare SOLO quando
             il Familiare è collegato a un anziano (insieme a Attività/Profilo).
             Sul form di collegamento non c'è alcuna barra (scelta A). -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/familiareToolbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            android:background="@color/care_primary"
            android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
            android:visibility="gone"
            app:titleTextColor="@color/care_on_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Stato: caricamento iniziale (verifica se già collegato) -->
        <ProgressBar
            android:id="@+id/caricamentoProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ===== FORM "non collegato": catena verticale CENTRATA nello schermo.
             Il titolo apre la catena (constraintTop=parent, constraintBottom al
             sottotitolo) con chainStyle="packed": il blocco intero galleggia al
             centro dello spazio disponibile, invece di stare incollato in alto. ===== -->
        <TextView
            android:id="@+id/collegaTitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginEnd="@dimen/screen_padding"
            android:text="Collegati al tuo assistito"
            android:textSize="@dimen/text_size_title"
            android:textColor="@color/care_on_surface"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/collegaSubtitleText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/collegaSubtitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginEnd="@dimen/screen_padding"
            android:text="Chiedi il codice invito alla persona che segui e inseriscilo qui sotto."
            android:textSize="@dimen/text_size_body"
            android:textColor="@color/care_on_surface"
            app:layout_constraintTop_toBottomOf="@id/collegaTitleText"
            app:layout_constraintBottom_toTopOf="@id/codiceInvitoEditText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/codiceInvitoEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginEnd="@dimen/screen_padding"
            android:hint="Codice invito"
            android:inputType="textCapCharacters"
            android:imeOptions="actionDone"
            android:maxLines="1"
            app:layout_constraintTop_toBottomOf="@id/collegaSubtitleText"
            app:layout_constraintBottom_toTopOf="@id/erroreCollegamentoText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/erroreCollegamentoText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginEnd="@dimen/screen_padding"
            android:textColor="@color/care_error"
            android:visibility="gone"
            tools:text="Codice non valido"
            app:layout_constraintTop_toBottomOf="@id/codiceInvitoEditText"
            app:layout_constraintBottom_toTopOf="@id/collegatiButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/collegatiButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_large"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginEnd="@dimen/screen_padding"
            android:text="Collegati"
            app:layout_constraintTop_toBottomOf="@id/erroreCollegamentoText"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ProgressBar
            android:id="@+id/collegamentoProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/collegatiButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/collegaGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="collegaTitleText,collegaSubtitleText,codiceInvitoEditText,collegatiButton" />

        <!-- Stato: già collegato. Il NavHost annidato (Attività/Profilo) è
             agganciato a runtime da HomeFamiliareFragment ed è vincolato
             SOTTO la Toolbar del ruolo. -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/familiareNavHostContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/familiareToolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/familiareBottomNav" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/familiareBottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/care_primary"
            app:elevation="8dp"
            app:labelVisibilityMode="labeled"
            app:itemIconTint="@color/bottom_nav_item_tint"
            app:itemTextColor="@color/bottom_nav_item_tint"
            app:itemActiveIndicatorStyle="@style/CareConnect.BottomNav.ActiveIndicator"
            app:menu="@menu/bottom_nav_familiare"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- La Toolbar è nel collegatoGroup: appare solo da collegati. -->
        <androidx.constraintlayout.widget.Group
            android:id="@+id/collegatoGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="familiareToolbar,familiareNavHostContainer,familiareBottomNav" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>