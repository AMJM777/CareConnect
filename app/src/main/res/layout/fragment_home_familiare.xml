<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- gli inset delle barre di sistema sono distribuiti nel fragment in base
         allo stato: alto alla toolbar (o alla radice per il form), basso alla bottom nav -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/care_background">

        <!-- barra superiore visibile solo quando il familiare è già collegato all'assistito -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/familiareToolbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            android:background="@color/care_primary"
            android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
            android:visibility="gone"
            app:titleTextColor="@color/care_on_primary"
            app:titleTextAppearance="@style/TextAppearance.CareConnect.TitleLarge"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- rotella di caricamento iniziale per verificare lo stato di collegamento -->
        <ProgressBar
            android:id="@+id/caricamentoProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- titolo della sezione di collegamento, raggruppato al centro dello schermo -->
        <TextView
            android:id="@+id/collegaTitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginEnd="@dimen/screen_padding"
            android:text="Collegati al tuo assistito"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            android:textColor="@color/care_primary"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/collegaSubtitleText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- sottotitolo con le istruzioni per ottenere il codice dall'assistito -->
        <TextView
            android:id="@+id/collegaSubtitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginEnd="@dimen/screen_padding"
            android:text="Chiedi il codice invito alla persona che segui e inseriscilo qui sotto."
            android:textSize="@dimen/text_size_body"
            android:textColor="@color/care_on_surface"
            app:layout_constraintTop_toBottomOf="@id/collegaTitleText"
            app:layout_constraintBottom_toTopOf="@id/codiceInvitoLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- campo dove il familiare digita il codice invito -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/codiceInvitoLayout"
            style="@style/CareConnect.TextField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginEnd="@dimen/screen_padding"
            android:hint="Codice invito"
            app:layout_constraintTop_toBottomOf="@id/collegaSubtitleText"
            app:layout_constraintBottom_toTopOf="@id/erroreCollegamentoText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/codiceInvitoEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:inputType="textCapCharacters"
                android:imeOptions="actionDone"
                android:maxLines="1"
                android:textColor="@color/care_on_surface" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- messaggio di errore in caso di codice non valido -->
        <TextView
            android:id="@+id/erroreCollegamentoText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginEnd="@dimen/screen_padding"
            android:textColor="@color/care_error"
            android:visibility="gone"
            tools:text="Codice non valido"
            app:layout_constraintTop_toBottomOf="@id/codiceInvitoLayout"
            app:layout_constraintBottom_toTopOf="@id/collegatiButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- bottone per confermare il codice e avviare il collegamento -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/collegatiButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_large"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginEnd="@dimen/screen_padding"
            android:text="Collegati"
            android:backgroundTint="@color/care_primary"
            android:textColor="@color/care_on_primary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="14dp"
            app:layout_constraintTop_toBottomOf="@id/erroreCollegamentoText"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- indicatore di attesa durante la verifica del codice inserito -->
        <ProgressBar
            android:id="@+id/collegamentoProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/collegatiButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- raggruppa gli elementi del modulo di collegamento per gestirne la visibilità in blocco -->
        <androidx.constraintlayout.widget.Group
            android:id="@+id/collegaGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="collegaTitleText,collegaSubtitleText,codiceInvitoLayout,collegatiButton" />

        <!-- contenitore dinamico per le schermate interne come attività e profilo -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/familiareNavHostContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/familiareToolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/familiareBottomNav" />

        <!-- menu di navigazione inferiore dedicato al familiare -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/familiareBottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/care_surface"
            app:elevation="8dp"
            app:labelVisibilityMode="labeled"
            app:itemIconTint="@color/bottom_nav_item_tint"
            app:itemTextColor="@color/bottom_nav_item_tint"
            app:itemActiveIndicatorStyle="@style/CareConnect.BottomNav.ActiveIndicator"
            app:menu="@menu/bottom_nav_familiare"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- raggruppa gli elementi dell'interfaccia attiva solo a collegamento avvenuto -->
        <androidx.constraintlayout.widget.Group
            android:id="@+id/collegatoGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="familiareToolbar,familiareNavHostContainer,familiareBottomNav" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>