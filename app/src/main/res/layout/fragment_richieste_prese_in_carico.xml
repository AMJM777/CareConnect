<?xml version="1.0" encoding="utf-8"?>
<!-- contenitore radice per abilitare il data binding -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- contenitore principale della schermata con sfondo e margini standard -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/care_background"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding">

        <!-- messaggio centrale mostrato solo quando non ci sono richieste prese in carico -->
        <TextView
            android:id="@+id/emptyStateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Non hai ancora preso in carico nessuna richiesta"
            android:textSize="@dimen/text_size_body"
            android:textColor="@color/care_on_surface"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- lista scorrevole delle richieste in carico, il padding scorre con gli elementi per un effetto pulito -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/richiesteRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:paddingTop="@dimen/screen_padding"
            android:paddingBottom="@dimen/screen_padding"
            android:clipToPadding="false"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>