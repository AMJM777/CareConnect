<?xml version="1.0" encoding="utf-8"?>
<!-- contenitore radice obbligatorio per abilitare il data binding -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- card della singola richiesta per l'anziano con margini per distanziarla nella lista -->
    <com.google.android.material.card.MaterialCardView
        style="@style/CareConnect.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_small"
        android:layout_marginEnd="@dimen/spacing_small"
        android:layout_marginTop="@dimen/spacing_small">

        <!-- layout interno della card che organizza i testi e i bottoni in verticale -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tipoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                android:textColor="@color/care_primary"
                tools:text="Spesa" />

            <TextView
                android:id="@+id/descrizioneText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/care_on_surface"
                tools:text="Ho bisogno di aiuto per fare la spesa settimanale" />

            <!-- indicatore a pillola per lo stato: pallino (tinta da adapter) + testo -->
            <TextView
                android:id="@+id/statoText"
                style="@style/CareConnect.StatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:drawableStart="@drawable/bg_status_dot"
                tools:text="Aperta" />

            <!-- nome del volontario assegnato, cliccabile per aprirne il profilo, visibile solo se accettata -->
            <TextView
                android:id="@+id/volontarioNomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                android:textColor="@color/care_primary_dark"
                android:visibility="gone"
                tools:text="Volontario: Mario Rossi"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/dataText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/care_on_surface_variant"
                tools:text="03/07/2026 14:30" />

            <!-- bottoni azione sulla stessa riga (l'anziano ne mostra al massimo due insieme) -->
            <LinearLayout
                android:id="@+id/azioniContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/spacing_medium">

                <!-- apre la chat con il volontario della richiesta (azione primaria) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chatButton"
                    style="@style/CareConnect.Button.Chat"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:text="Chat" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/modificaButton"
                    style="@style/CareConnect.Button.Outline"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:text="Modifica"
                    app:icon="@drawable/ic_modifica" />

                <!-- annullamento: outline neutro (niente rosso, riservato all'SOS) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/annullaButton"
                    style="@style/CareConnect.Button.Outline"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Annulla"
                    app:icon="@drawable/ic_annulla" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>
</layout>