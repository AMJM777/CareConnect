<?xml version="1.0" encoding="utf-8"?>
<!-- contenitore radice obbligatorio per abilitare il data binding -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- collegamento con il viewmodel per popolare i dati dell'interfaccia dinamicamente -->
    <data>
        <variable
            name="viewModel"
            type="com.careconnect.viewmodel.volontario.ProfiloVolontarioViewModel" />
        <import type="android.view.View" />
    </data>

    <!-- vista scorrevole per evitare che la tastiera nasconda i campi durante la digitazione -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/care_background"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- immagine di profilo standard arrotondata per il volontario -->
            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_medium"
                android:background="@drawable/bg_avatar_circle"
                android:src="@drawable/ic_person"
                android:scaleType="fitCenter"
                android:padding="22dp"
                android:contentDescription="@null" />

            <!-- nome dell'utente caricato dinamicamente dal viewmodel -->
            <TextView
                android:id="@+id/nomeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:gravity="center"
                android:text="@{viewModel.nome}"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                android:textColor="@color/care_on_surface"
                tools:text="Mario Rossi" />

            <!-- etichetta visiva che identifica chiaramente il ruolo dell'utente -->
            <TextView
                style="@style/CareConnect.StatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="Volontario" />

            <!-- indirizzo email collegato in automatico ai dati del profilo -->
            <TextView
                android:id="@+id/emailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:gravity="center"
                android:text="@{viewModel.email}"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/care_on_surface_variant"
                tools:text="mario.rossi@email.com" />

            <!-- scheda valutazioni ricevute -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CareConnect.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Le tue valutazioni"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        android:textColor="@color/care_on_surface" />

                    <!-- mostrato solo senza voto; con un voto restano le stelle -->
                    <TextView
                        android:id="@+id/ratingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="Non ancora valutato"
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/care_on_surface_variant"
                        android:visibility="@{viewModel.haValutazione ? View.GONE : View.VISIBLE}" />

                    <!-- stelle in sola lettura -->
                    <RatingBar
                        android:id="@+id/ratingBar"
                        style="?android:attr/ratingBarStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:isIndicator="true"
                        android:numStars="5"
                        android:stepSize="0.5"
                        android:rating="@{viewModel.ratingStelle}"
                        android:progressTint="@color/care_accent"
                        android:secondaryProgressTint="@color/care_accent"
                        android:progressBackgroundTint="@color/care_outline"
                        android:contentDescription="@{viewModel.valutazione}"
                        android:visibility="@{viewModel.haValutazione ? View.VISIBLE : View.GONE}" />

                    <!-- titolo dei commenti: visibile solo se ce n'è almeno uno -->
                    <TextView
                        android:id="@+id/recensioniTitolo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:text="Commenti ricevuti"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        android:textColor="@color/care_on_surface"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <!-- contenitore riempito a runtime con una riga per commento -->
                    <LinearLayout
                        android:id="@+id/recensioniContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="@dimen/spacing_small" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- scheda per visualizzare e modificare la descrizione personale -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CareConnect.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Descrizione (facoltativa)"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        android:textColor="@color/care_on_surface" />

                    <!-- campo di testo per inserire o aggiornare la bio utente -->
                    <EditText
                        android:id="@+id/bioEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:minLines="3"
                        android:gravity="top|start"
                        android:inputType="textMultiLine"
                        android:hint="Racconta qualcosa di te a chi riceverà il tuo aiuto"
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/care_on_surface"
                        android:background="@drawable/bg_input_outline"
                        android:padding="@dimen/spacing_medium" />

                    <!-- bottone manuale per confermare il salvataggio della bio utente -->
                    <Button
                        android:id="@+id/salvaBioButton"
                        style="@style/CareConnect.Button.Accent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="Salva descrizione" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- bottone rosso di disconnessione dall'account -->
            <Button
                android:id="@+id/logoutButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_large"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:text="Esci"
                android:backgroundTint="@color/care_error"
                android:textColor="@color/care_on_error"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="14dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>
</layout>