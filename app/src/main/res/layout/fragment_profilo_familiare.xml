<?xml version="1.0" encoding="utf-8"?>
<!-- contenitore radice obbligatorio per abilitare il data binding -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- collegamento con il viewmodel per popolare i dati dell'interfaccia dinamicamente -->
    <data>
        <variable
            name="viewModel"
            type="com.careconnect.viewmodel.familiare.ProfiloFamiliareViewModel" />
    </data>

    <!-- vista scorrevole per adattarsi a schermi di diverse dimensioni -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/care_background"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- immagine di profilo per il familiare -->
            <ImageView
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_medium"
                android:background="@drawable/bg_avatar_circle"
                android:src="@drawable/ic_person"
                android:scaleType="fitCenter"
                android:padding="24dp"
                app:tint="@color/care_primary"
                android:contentDescription="@null" />

            <!-- nome del familiare caricato dinamicamente dal viewmodel -->
            <TextView
                android:id="@+id/nomeFamiliareText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:gravity="center"
                android:text="@{viewModel.nomeFamiliareTesto}"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                android:textColor="@color/care_on_surface"
                tools:text="Marco" />

            <!-- etichetta visiva che identifica chiaramente il ruolo dell'utente -->
            <TextView
                style="@style/CareConnect.StatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="Familiare" />

            <!-- email del familiare, collegata ai dati del profilo -->
            <TextView
                android:id="@+id/emailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:gravity="center"
                android:text="@{viewModel.email}"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/care_on_surface_variant"
                tools:text="marco.rossi@email.com" />

            <!-- scheda delle persone seguite + collegamento di un nuovo anziano -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CareConnect.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Le persone che segui"
                        style="@style/CareConnect.SectionLabel" />

                    <!-- mostrato solo se non segui ancora nessuno -->
                    <TextView
                        android:id="@+id/nessunAnzianoText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="Non segui ancora nessuno. Collega un anziano qui sotto."
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/care_on_surface_variant"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <!-- riempito a runtime con una riga per anziano seguito -->
                    <LinearLayout
                        android:id="@+id/anzianiContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="@dimen/spacing_small" />

                    <!-- collegamento di un nuovo anziano tramite codice invito -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:text="Collega un altro anziano"
                        style="@style/CareConnect.SectionLabel" />

                    <EditText
                        android:id="@+id/codiceInvitoEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:hint="Inserisci il codice invito"
                        android:inputType="textCapCharacters"
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/care_on_surface"
                        android:background="@drawable/bg_input_outline"
                        android:padding="@dimen/spacing_medium" />

                    <Button
                        android:id="@+id/collegaButton"
                        style="@style/CareConnect.Button.Accent"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:text="Collega" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- scheda informativa sul ruolo del familiare -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CareConnect.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Il tuo ruolo"
                        style="@style/CareConnect.SectionLabel" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="Segui l'attività della persona che assisti e ricevi i suoi allarmi SOS. Puoi confermare e recensire le richieste completate dai volontari."
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/care_on_surface" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- disconnessione: outline neutro (niente rosso, riservato all'SOS) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/logoutButton"
                style="@style/CareConnect.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_large"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:text="Esci"
                app:icon="@drawable/ic_esci" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>
</layout>