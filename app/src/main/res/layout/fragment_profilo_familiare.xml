<?xml version="1.0" encoding="utf-8"?>
<!-- contenitore radice obbligatorio per abilitare il data binding -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- collegamento con il viewmodel per popolare i dati dell'interfaccia dinamicamente -->
    <data>
        <variable
            name="viewModel"
            type="com.careconnect.viewmodel.familiare.ProfiloFamiliareViewModel" />
    </data>

    <!-- vista scorrevole per adattarsi a schermi di diverse dimensioni -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/care_background"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- immagine di profilo standard arrotondata per il familiare -->
            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_medium"
                android:background="@drawable/bg_avatar_circle"
                android:src="@drawable/ic_person"
                android:scaleType="fitCenter"
                android:padding="22dp"
                android:contentDescription="@null" />

            <!-- nome del familiare caricato dinamicamente dal viewmodel -->
            <TextView
                android:id="@+id/nomeFamiliareText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:gravity="center"
                android:text="@{viewModel.nomeFamiliareTesto}"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                android:textColor="@color/care_on_surface"
                tools:text="Sei collegato/a come: Marco" />

            <!-- etichetta visiva che identifica chiaramente il ruolo dell'utente -->
            <TextView
                style="@style/CareConnect.StatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="Familiare" />

            <!-- scheda riepilogativa del collegamento con l'assistito -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CareConnect.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Il tuo collegamento"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        android:textColor="@color/care_on_surface" />

                    <!-- nome dell'anziano seguito gestito in tempo reale dal viewmodel -->
                    <TextView
                        android:id="@+id/nomeAnzianoText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="@{viewModel.nomeAnzianoTesto}"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        android:textColor="@color/care_primary"
                        tools:text="Stai seguendo: Maria" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- bottone rosso di disconnessione dall'account -->
            <Button
                android:id="@+id/logoutButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_large"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:text="Esci"
                android:backgroundTint="@color/care_error"
                android:textColor="@color/care_on_error"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="14dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>
</layout>