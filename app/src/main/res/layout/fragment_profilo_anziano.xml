<?xml version="1.0" encoding="utf-8"?>
<!-- contenitore radice obbligatorio per abilitare il data binding -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- collegamento con il viewmodel per popolare i dati dell'interfaccia dinamicamente -->
    <data>
        <variable
            name="viewModel"
            type="com.careconnect.viewmodel.anziano.ProfiloAnzianoViewModel" />
    </data>

    <!-- vista scorrevole per evitare che la tastiera nasconda i campi durante la digitazione -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/care_background"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- immagine di profilo standard arrotondata per l'anziano -->
            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_medium"
                android:background="@drawable/bg_avatar_circle"
                android:src="@drawable/ic_person"
                android:scaleType="fitCenter"
                android:padding="22dp"
                android:contentDescription="@null" />

            <!-- nome dell'utente caricato dinamicamente dal viewmodel -->
            <TextView
                android:id="@+id/nomeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:gravity="center"
                android:text="@{viewModel.nome}"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                android:textColor="@color/care_on_surface"
                tools:text="Maria Rossi" />

            <!-- etichetta visiva che identifica chiaramente il ruolo dell'utente -->
            <TextView
                style="@style/CareConnect.StatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="Anziano" />

            <!-- indirizzo email collegato in automatico ai dati del profilo -->
            <TextView
                android:id="@+id/emailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:gravity="center"
                android:text="@{viewModel.email}"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/care_on_surface_variant"
                tools:text="maria.rossi@email.it" />

            <!-- scheda contenente il codice univoco da condividere con i familiari -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CareConnect.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Codice per i tuoi familiari"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        android:textColor="@color/care_on_surface" />

                    <!-- testo del codice di invito gestito in tempo reale dal viewmodel -->
                    <TextView
                        android:id="@+id/codiceInvitoText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="@{viewModel.codiceInvitoTesto}"
                        android:textSize="@dimen/text_size_title"
                        android:textStyle="bold"
                        android:textColor="@color/care_primary"
                        android:letterSpacing="0.2"
                        tools:text="A7K9P2" />

                    <!-- bottone per copiare il codice che si attiva solo quando il dato è pronto -->
                    <Button
                        android:id="@+id/copiaCodiceButton"
                        style="@style/CareConnect.Button.Accent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:enabled="@{viewModel.copiaAbilitato}"
                        android:text="Copia codice" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- scheda di sola lettura per mostrare i familiari collegati al codice invito-->
            <com.google.android.material.card.MaterialCardView
                style="@style/CareConnect.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="I tuoi familiari collegati"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        android:textColor="@color/care_on_surface" />

                    <!-- contenitore riempito dal Fragment con una riga per familiare -->
                    <LinearLayout
                        android:id="@+id/garantiContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:orientation="vertical" />

                    <!-- messaggio quando nessun familiare si è ancora collegato -->
                    <TextView
                        android:id="@+id/garantiVuotoText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="Nessun familiare collegato. Condividi il codice qui sopra."
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/care_on_surface_variant" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- scheda per visualizzare e modificare l'indirizzo di residenza -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CareConnect.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Il tuo indirizzo"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        android:textColor="@color/care_on_surface" />

                    <!-- campo di testo per inserire o aggiornare l'indirizzo -->
                    <EditText
                        android:id="@+id/indirizzoEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:hint="Es: Via Roma 12, Milano"
                        android:inputType="textPostalAddress"
                        android:maxLines="2"
                        android:textColor="@color/care_on_surface"
                        android:background="@drawable/bg_input_outline"
                        android:padding="@dimen/spacing_medium" />

                    <!-- bottone manuale per confermare il salvataggio del nuovo indirizzo -->
                    <Button
                        android:id="@+id/salvaIndirizzoButton"
                        style="@style/CareConnect.Button.Accent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="Salva indirizzo" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- scheda protezione SOS in background (T4): interruttore opt-out -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CareConnect.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Protezione SOS"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        android:textColor="@color/care_on_surface" />

                    <!-- interruttore grande e con testo: mai solo il colore a dire lo stato -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/protezioneSosSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:minHeight="56dp"
                        android:text="Chiedi aiuto scuotendo il telefono, anche con l'app chiusa"
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/care_on_surface" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- bottone rosso di disconnessione dall'account -->
            <Button
                android:id="@+id/logoutButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_large"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:text="Esci"
                android:backgroundTint="@color/care_error"
                android:textColor="@color/care_on_error" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>
</layout>