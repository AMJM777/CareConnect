<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.careconnect.viewmodel.anziano.ProfiloAnzianoViewModel" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/care_background"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- ===== INTESTAZIONE: avatar + nome + ruolo + email ===== -->
            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_medium"
                android:background="@drawable/bg_avatar_circle"
                android:src="@drawable/ic_person"
                android:scaleType="fitCenter"
                android:padding="22dp"
                android:contentDescription="@null" />

            <!-- Nome: legato al LiveData del ViewModel. -->
            <TextView
                android:id="@+id/nomeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:gravity="center"
                android:text="@{viewModel.nome}"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                android:textColor="@color/care_on_surface"
                tools:text="Maria Rossi" />

            <TextView
                style="@style/CareConnect.StatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="Anziano" />

            <!-- Email: legata alla proprietà del ViewModel. -->
            <TextView
                android:id="@+id/emailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:gravity="center"
                android:text="@{viewModel.email}"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/care_on_surface_variant"
                tools:text="maria.rossi@email.it" />

            <!-- ===== CARD: codice invito per i familiari ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CareConnect.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Codice per i tuoi familiari"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        android:textColor="@color/care_on_surface" />

                    <!-- Codice invito: legato al LiveData (mostra "..." finché
                         non è pronto). -->
                    <TextView
                        android:id="@+id/codiceInvitoText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="@{viewModel.codiceInvitoTesto}"
                        android:textSize="@dimen/text_size_title"
                        android:textStyle="bold"
                        android:textColor="@color/care_primary"
                        android:letterSpacing="0.2"
                        tools:text="A7K9P2" />

                    <!-- Bottone abilitato dal DataBinding solo quando il
                         codice è disponibile. -->
                    <Button
                        android:id="@+id/copiaCodiceButton"
                        style="@style/CareConnect.Button.Accent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:enabled="@{viewModel.copiaAbilitato}"
                        android:text="Copia codice" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ===== CARD: indirizzo (EDITABILE, gestito a mano) ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CareConnect.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Il tuo indirizzo"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        android:textColor="@color/care_on_surface" />

                    <!-- Campo editabile: NON legato in due vie. Lo pre-riempie
                         il Fragment una volta e lo legge al click su "Salva". -->
                    <EditText
                        android:id="@+id/indirizzoEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:hint="Es: Via Roma 12, Milano"
                        android:inputType="textPostalAddress"
                        android:maxLines="2"
                        android:textColor="@color/care_on_surface"
                        android:background="@drawable/bg_input_outline"
                        android:padding="@dimen/spacing_medium" />

                    <Button
                        android:id="@+id/salvaIndirizzoButton"
                        style="@style/CareConnect.Button.Accent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="Salva indirizzo" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ===== ESCI ===== -->
            <Button
                android:id="@+id/logoutButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_large"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:text="Esci"
                android:backgroundTint="@color/care_error"
                android:textColor="@color/care_on_error" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>
</layout>