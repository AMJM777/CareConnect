<?xml version="1.0" encoding="utf-8"?>
<!-- contenitore radice per abilitare il data binding -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- contenitore principale della schermata con sfondo e margini standard -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/care_background"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding">

        <!-- banner rosso di emergenza nascosto di default -->
        <LinearLayout
            android:id="@+id/sosBanner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:orientation="vertical"
            android:background="@color/care_sos"
            android:padding="@dimen/spacing_medium"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- testo di avviso per l'allarme SOS lanciato dall'assistito -->
            <TextView
                android:id="@+id/sosText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Il tuo assistito ha lanciato un allarme SOS"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                android:textColor="@color/care_on_primary" />

            <!-- conferma presa visione-->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/chiudiSosButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:minHeight="@dimen/touch_target_min"
                android:text="Ho visto, chiudi"
                android:textColor="@color/care_on_primary"
                app:strokeColor="@color/care_on_primary"
                app:icon="@drawable/ic_spunta"
                app:iconTint="@color/care_on_primary"
                app:cornerRadius="@dimen/button_corner_radius" />

        </LinearLayout>

        <!-- titolo del selettore: visibile solo con più di un anziano -->
        <TextView
            android:id="@+id/selettoreTitolo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="Stai seguendo"
            style="@style/CareConnect.SectionLabel"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/sosBanner"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- selettore degli anziani seguiti: visibile solo con più di un anziano -->
        <HorizontalScrollView
            android:id="@+id/selettoreAnziani"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:scrollbars="none"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/selettoreTitolo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/anzianiChipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true"
                app:selectionRequired="true" />

        </HorizontalScrollView>

        <!-- messaggio centrale mostrato solo quando la lista delle attività è vuota -->
        <TextView
            android:id="@+id/emptyStateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:drawableTop="@drawable/ic_empty"
            android:drawableTint="@color/care_on_surface_variant"
            android:drawablePadding="@dimen/spacing_medium"
            android:text="Nessuna richiesta da mostrare"
            android:textSize="@dimen/text_size_body"
            android:textColor="@color/care_on_surface"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/selettoreAnziani"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- lista scorrevole per mostrare le singole card delle attività da monitorare -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/richiesteRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:paddingTop="@dimen/screen_padding"
            android:paddingBottom="@dimen/screen_padding"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/selettoreAnziani"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>