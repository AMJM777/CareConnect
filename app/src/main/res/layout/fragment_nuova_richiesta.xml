<?xml version="1.0" encoding="utf-8"?>
<!-- contenitore radice obbligatorio per il data binding -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- vista scorrevole: evita che la tastiera copra i campi -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/care_background"
        android:clipToPadding="false"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/screen_padding">

            <!-- card che raccoglie il form -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/formCard"
                style="@style/CareConnect.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- scelta del tipo di aiuto -->
                    <LinearLayout
                        android:id="@+id/tipoContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tipoSpesa"
                            style="@style/CareConnect.OptionToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="Spesa"
                            app:icon="@drawable/ic_spesa" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tipoBolletta"
                            style="@style/CareConnect.OptionToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:checkable="true"
                            android:text="Bolletta"
                            app:icon="@drawable/ic_bolletta" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tipoAssistenzaDigitale"
                            style="@style/CareConnect.OptionToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:checkable="true"
                            android:text="Assistenza digitale"
                            app:icon="@drawable/ic_assistenza_digitale" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tipoAltro"
                            style="@style/CareConnect.OptionToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:checkable="true"
                            android:text="Altro"
                            app:icon="@drawable/ic_altro" />

                    </LinearLayout>

                    <!-- campo libero, visibile solo con la scelta "altro" -->
                    <EditText
                        android:id="@+id/altroInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:minHeight="@dimen/touch_target_min"
                        android:background="@drawable/bg_input_outline"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp"
                        android:hint="Specifica (facoltativo)"
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/care_on_surface"
                        android:textColorHint="@color/care_on_surface_variant"
                        android:visibility="gone" />

                    <!-- dettagli della richiesta -->
                    <EditText
                        android:id="@+id/descrizioneInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_large"
                        android:background="@drawable/bg_input_outline"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp"
                        android:hint="Descrivi di cosa hai bisogno"
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/care_on_surface"
                        android:textColorHint="@color/care_on_surface_variant"
                        android:minLines="3"
                        android:gravity="top|start" />

                    <!-- messaggio di errore di validazione -->
                    <TextView
                        android:id="@+id/errorText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:textColor="@color/care_error"
                        android:textSize="@dimen/text_size_body"
                        android:visibility="gone" />

                    <!-- salvataggio della richiesta: azione primaria prugna -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/inviaButton"
                        style="@style/CareConnect.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/spacing_large"
                        android:text="Invia richiesta" />

                    <!-- rotella durante l'invio -->
                    <ProgressBar
                        android:id="@+id/loadingIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>
</layout>
