<?xml version="1.0" encoding="utf-8"?>
<!-- grafo di navigazione interno per la sezione familiare con le destinazioni della bottom bar -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_familiare"
    app:startDestination="@id/attivitaFamiliareFragment">

    <!-- schermata iniziale: elenco delle richieste dell'anziano seguito, con conferma e valutazione -->
    <fragment
        android:id="@+id/attivitaFamiliareFragment"
        android:name="com.careconnect.ui.familiare.AttivitaFamiliareFragment"
        android:label="Attività" />

    <!-- profilo del familiare: nome proprio, nome dell'anziano seguito, logout -->
    <fragment
        android:id="@+id/profiloFamiliareFragment"
        android:name="com.careconnect.ui.familiare.ProfiloFamiliareFragment"
        android:label="Profilo" />

    <!-- chat dell'assistito in sola lettura (visibilità del garante, safeguarding) -->
    <fragment
        android:id="@+id/chatFragment"
        android:name="com.careconnect.ui.chat.ChatFragment"
        android:label="Chat" />

</navigation>