<?xml version="1.0" encoding="utf-8"?>
<!-- grafo di navigazione interno per la sezione anziano con le destinazioni della bottom bar e schermate figlie -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_anziano"
    app:startDestination="@id/dashboardAnzianoFragment">

    <!-- schermata principale con il riepilogo per l'assistito -->
    <fragment
        android:id="@+id/dashboardAnzianoFragment"
        android:name="com.careconnect.ui.anziano.DashboardAnzianoFragment"
        android:label="Home" />

    <!-- schermata riutilizzabile sia per creare una nuova richiesta che per modificarne una esistente -->
    <fragment
        android:id="@+id/nuovaRichiestaFragment"
        android:name="com.careconnect.ui.anziano.NuovaRichiestaFragment"
        android:label="Nuova richiesta" />

    <!-- schermata per visualizzare l'elenco e lo stato delle proprie richieste -->
    <fragment
        android:id="@+id/mieRichiesteFragment"
        android:name="com.careconnect.ui.anziano.MieRichiesteFragment"
        android:label="Le mie richieste" />

    <!-- schermata per gestire i dati personali e il codice di condivisione con i familiari -->
    <fragment
        android:id="@+id/profiloAnzianoFragment"
        android:name="com.careconnect.ui.anziano.ProfiloAnzianoFragment"
        android:label="Profilo" />

</navigation>