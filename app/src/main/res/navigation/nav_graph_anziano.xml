<?xml version="1.0" encoding="utf-8"?>
<!-- grafo di navigazione interno per la sezione anziano con le destinazioni della bottom bar, schermata di modifica raggiunta da "le mie richieste" -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_anziano"
    app:startDestination="@id/nuovaRichiestaHomeFragment">

    <!-- HOME del ruolo: form "Nuova richiesta" diretto + banner "in corso" + SOS -->
    <fragment
        android:id="@+id/nuovaRichiestaHomeFragment"
        android:name="com.careconnect.ui.anziano.NuovaRichiestaHomeFragment"
        android:label="Nuova richiesta" />

    <!-- MODIFICA di una richiesta esistente (raggiunta da "Le mie richieste") -->
    <fragment
        android:id="@+id/nuovaRichiestaFragment"
        android:name="com.careconnect.ui.anziano.NuovaRichiestaFragment"
        android:label="Modifica richiesta" />

    <!-- elenco e stato delle proprie richieste -->
    <fragment
        android:id="@+id/mieRichiesteFragment"
        android:name="com.careconnect.ui.anziano.MieRichiesteFragment"
        android:label="Le mie richieste" />

    <!-- dati personali e codice di condivisione con i familiari -->
    <fragment
        android:id="@+id/profiloAnzianoFragment"
        android:name="com.careconnect.ui.anziano.ProfiloAnzianoFragment"
        android:label="Profilo" />

    <!-- schermata chat con il volontario di una richiesta presa in carico -->
    <fragment
        android:id="@+id/chatFragment"
        android:name="com.careconnect.ui.chat.ChatFragment"
        android:label="Chat" />
</navigation>