<?xml version="1.0" encoding="utf-8"?>
<!-- Grafo principale dell'app: include il grafo di autenticazione come
     nested graph, più le 3 home per ruolo. startDestination è ora
     splashFragment (Fase 4): decide runtime se saltare al login o
     direttamente alla home corretta, invece di mostrare sempre il login. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_main"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.careconnect.ui.auth.SplashFragment"
        android:label="Caricamento" />

    <include app:graph="@navigation/nav_graph_auth" />

    <fragment
        android:id="@+id/homeAnzianoFragment"
        android:name="com.careconnect.ui.anziano.HomeAnzianoFragment"
        android:label="Home Anziano">

        <action
            android:id="@+id/action_homeAnziano_to_nuovaRichiesta"
            app:destination="@id/nuovaRichiestaFragment" />

    </fragment>

    <fragment
        android:id="@+id/nuovaRichiestaFragment"
        android:name="com.careconnect.ui.anziano.NuovaRichiestaFragment"
        android:label="Nuova richiesta" />

    <fragment
        android:id="@+id/homeVolontarioFragment"
        android:name="com.careconnect.ui.volontario.HomeVolontarioFragment"
        android:label="Home Volontario" />

    <fragment
        android:id="@+id/homeFamiliareFragment"
        android:name="com.careconnect.ui.familiare.HomeFamiliareFragment"
        android:label="Home Familiare" />

</navigation>