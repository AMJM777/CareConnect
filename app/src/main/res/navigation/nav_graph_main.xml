<?xml version="1.0" encoding="utf-8"?>
<!-- Grafo principale dell'app: include il grafo di autenticazione come
     nested graph, più le 3 home per ruolo (placeholder per ora,
     diventeranno grafi propri quando costruiremo Fase 4-6). -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_main"
    app:startDestination="@id/nav_graph_auth">

    <include app:graph="@navigation/nav_graph_auth" />

    <fragment
        android:id="@+id/homeAnzianoFragment"
        android:name="com.careconnect.ui.anziano.HomeAnzianoFragment"
        android:label="Home Anziano" />

    <fragment
        android:id="@+id/homeVolontarioFragment"
        android:name="com.careconnect.ui.volontario.HomeVolontarioFragment"
        android:label="Home Volontario" />

    <fragment
        android:id="@+id/homeFamiliareFragment"
        android:name="com.careconnect.ui.familiare.HomeFamiliareFragment"
        android:label="Home Familiare" />

</navigation>