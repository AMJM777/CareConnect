<?xml version="1.0" encoding="utf-8"?>
<!-- Grafo di navigazione per il flusso di autenticazione: login, registrazione,
     e la schermata di completamento profilo per il primo accesso Google.
     È un grafo "annidato": verrà incluso dentro il grafo principale
     dell'app (che aggiungerò con le home per ruolo), così resta
     leggibile e isolato come singola unità logica. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_auth"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.careconnect.ui.auth.LoginFragment"
        android:label=""
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_login_to_registrazione"
            app:destination="@id/registrazioneFragment" />

        <action
            android:id="@+id/action_login_to_completaProfiloGoogle"
            app:destination="@id/completaProfiloGoogleFragment" />

    </fragment>

    <fragment
        android:id="@+id/registrazioneFragment"
        android:name="com.careconnect.ui.auth.RegistrazioneFragment"
        android:label="Registrati"
        tools:layout="@layout/fragment_registrazione">

        <!-- popUpTo + popUpToInclusive: torna a Login "pulendo" Registrazione
             dallo stack, così il tasto Indietro da Login non riporta qui. -->
        <action
            android:id="@+id/action_registrazione_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/completaProfiloGoogleFragment"
        android:name="com.careconnect.ui.auth.CompletaProfiloGoogleFragment"
        android:label="Completa profilo"
        tools:layout="@layout/fragment_completa_profilo_google" />

</navigation>