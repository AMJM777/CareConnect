<?xml version="1.0" encoding="utf-8"?>
<!-- Bordo dei campi di input: indaco spesso quando il campo è a fuoco,
     outline tenue a riposo. Il focus ben visibile aiuta l'utente anziano. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/care_surface" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/care_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/care_surface" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/care_input_outline" />
        </shape>
    </item>
</selector>