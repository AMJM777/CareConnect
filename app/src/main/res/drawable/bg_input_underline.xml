<?xml version="1.0" encoding="utf-8"?>
<!-- Campo di input sottolineato: solo la linea in basso (le altre sono spinte
     fuori dalla vista con inset negativi). Prugna spessa a fuoco, neutra a riposo. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:top="-4dp" android:left="-4dp" android:right="-4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="2dp" android:color="@color/care_primary" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="-4dp" android:left="-4dp" android:right="-4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="1.5dp" android:color="@color/care_input_outline" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
