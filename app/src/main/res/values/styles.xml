<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- sfondo a pillola per la voce attiva nella barra di navigazione inferiore -->
    <style name="CareConnect.BottomNav.ActiveIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/care_accent_container</item>
    </style>

    <!-- card con angoli arrotondati, profondità leggera e bordo tenue -->
    <style name="CareConnect.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">1dp</item>
        <item name="cardBackgroundColor">@color/care_surface</item>
        <item name="strokeColor">@color/care_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">@dimen/spacing_medium</item>
    </style>

    <!-- etichetta di stato a pillola: sfondo + testo + PALLINO (drawableStart) impostati
         dinamicamente da StatoRichiestaColori. Il pallino garantisce "mai solo colore". -->
    <style name="CareConnect.StatusChip" parent="">
        <item name="android:background">@drawable/bg_status_chip</item>
        <item name="android:backgroundTint">@color/care_primary_container</item>
        <item name="android:textColor">@color/care_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_size_label</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <!-- AZIONE SECONDARIA: fill pesca con testo prugna (5,96:1), angoli 14dp,
         altezza da target anziano (56dp). Es: "Copia codice", "Salva indirizzo", "Invia richiesta". -->
    <style name="CareConnect.Button.Accent" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/care_accent_soft</item>
        <item name="android:textColor">@color/care_on_accent</item>
        <item name="iconTint">@color/care_on_accent</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textSize">@dimen/text_size_button</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- AZIONE TERZIARIA / OUTLINE: bordo neutro #C9C2B2, testo prugna.
         Es: "Modifica", "Annulla" (icona + parola, NON rosso), "Esci". -->
    <style name="CareConnect.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/care_outline_button</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/care_primary</item>
        <item name="iconTint">@color/care_primary</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textSize">@dimen/text_size_button</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- SOS: rosso emergenza, testo bianco, più grande (64dp). Rosso riservato SOLO qui. -->
    <style name="CareConnect.Button.Sos" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/care_sos</item>
        <item name="android:textColor">@color/care_on_sos</item>
        <item name="iconTint">@color/care_on_sos</item>
        <item name="icon">@drawable/ic_emergenza</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">12dp</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- campo di testo con etichetta flottante e angoli coerenti -->
    <style name="CareConnect.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/button_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/button_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/button_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/button_corner_radius</item>
    </style>

    <!-- AZIONE PRIMARIA CHAT: fill prugna pieno con testo bianco e icona (redesign).
         Reso più riconoscibile rispetto agli altri bottoni della card. -->
    <style name="CareConnect.Button.Chat" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/care_primary</item>
        <item name="android:textColor">@color/care_on_primary</item>
        <item name="iconTint">@color/care_on_primary</item>
        <item name="icon">@drawable/ic_chat</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textSize">@dimen/text_size_button</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- AZIONE PRIMARIA MORBIDA: viola chiaro (lavanda) con testo prugna.
         Meno "pesante" del primario pieno. Es: "Prendi in carico". -->
    <style name="CareConnect.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/care_primary_container</item>
        <item name="android:textColor">@color/care_primary</item>
        <item name="iconTint">@color/care_primary</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textSize">@dimen/text_size_button</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- BOTTONI SOLO-ICONA (profili volontario/familiare, azioni chiare): icona centrata,
         nessuna etichetta visibile ma contentDescription per lo screen reader. -->
    <style name="CareConnect.IconButton.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/care_primary</item>
        <item name="iconTint">@color/care_on_primary</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="CareConnect.IconButton.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/care_outline_button</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="iconTint">@color/care_primary</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="CareConnect.IconButton.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/care_primary_container</item>
        <item name="iconTint">@color/care_primary</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- chip selettore anziano (familiare con più assistiti): selezionabile, coerente
         coi bottoni (angoli arrotondati, prugna se selezionato). Nessuna icona di spunta. -->
    <style name="CareConnect.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/option_toggle_bg</item>
        <item name="android:textColor">@color/option_toggle_fg</item>
        <item name="chipStrokeColor">@color/care_input_outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textStyle">bold</item>
        <item name="chipCornerRadius">@dimen/button_corner_radius</item>
        <item name="chipMinHeight">44dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
    </style>

    <!-- tessera di scelta del tipo di aiuto: piena se selezionata, con bordo se no -->
    <style name="CareConnect.OptionToggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/option_toggle_bg</item>
        <item name="android:textColor">@color/option_toggle_fg</item>
        <item name="iconTint">@color/option_toggle_fg</item>
        <item name="strokeColor">@color/care_primary</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>

    <!-- tema per l'overlay SOS-->
    <style name="CareConnect.Dialog.Sos" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="fontFamily">@font/atkinson</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.CareConnect.LabelLarge</item>
    </style>

    <!-- tema per ConfermaSosActivity-->
    <style name="Theme.CareConnect.ConfermaSos" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="fontFamily">@font/atkinson</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.CareConnect.LabelLarge</item>
    </style>

</resources>