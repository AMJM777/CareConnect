<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- sfondo a pillola per la voce attiva nella barra di navigazione inferiore -->
    <style name="CareConnect.BottomNav.ActiveIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#33FFFFFF</item>
    </style>

    <!-- stile base per le card con angoli arrotondati, ombra leggera e bordi tenui -->
    <style name="CareConnect.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/care_surface</item>
        <item name="strokeColor">@color/care_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">@dimen/spacing_medium</item>
    </style>

    <!-- stile per l'etichetta di stato a forma di pillola, i colori cambieranno dinamicamente -->
    <style name="CareConnect.StatusChip" parent="">
        <item name="android:background">@drawable/bg_status_chip</item>
        <item name="android:backgroundTint">@color/care_primary_container</item>
        <item name="android:textColor">@color/care_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- bottone per azioni secondarie con tinte di accento arancioni -->
    <style name="CareConnect.Button.Accent" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/care_accent_container</item>
        <item name="android:textColor">@color/care_accent</item>
        <item name="iconTint">@color/care_accent</item>
    </style>

</resources>