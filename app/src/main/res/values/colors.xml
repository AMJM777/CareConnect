<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- prugna: barra superiore, azioni primarie, sezioni principali -->
    <color name="care_primary">#FF4A2140</color>
    <color name="care_primary_variant">#FF3A1A33</color>
    <color name="care_primary_container">#FFEEE1E8</color>
    <color name="care_on_primary">#FFFFFFFF</color>

    <!-- pesca: accento caldo per gli elementi interattivi di spicco.
         NB: essendo un tono chiaro, il testo/icona SOPRA l'accento e' scuro
         (care_on_accent) -->
    <color name="care_accent">#FFE39B7B</color>
    <color name="care_accent_variant">#FF9A4A2E</color>
    <color name="care_accent_container">#FFF6DDD0</color>
    <color name="care_on_accent">#FF2A1E28</color>

    <!-- pulsante chat: interno pesca tenue con testo pesca scuro -->
    <color name="care_chat">#FFF6DDD0</color>
    <color name="care_on_chat">#FF9A4A2E</color>

    <!-- rosso acceso riservato ESCLUSIVAMENTE all'emergenza (banner e bottone SOS) -->
    <color name="care_sos">#FFD32F2F</color>
    <color name="care_on_sos">#FFFFFFFF</color>

    <!-- sfondi caldi (carta rosata), card e gerarchie di testo -->
    <color name="care_background">#FFF7F1F3</color>
    <color name="care_surface">#FFFFFFFF</color>
    <color name="care_on_surface">#FF2A1E28</color>
    <color name="care_on_surface_variant">#FF5F5560</color>
    <color name="care_outline">#FFE9DEE3</color>

    <!-- near-black caldo per i testi principali (login, messaggi, dialog) -->
    <color name="care_primary_dark">#FF22141E</color>

    <!-- rosso scuro per gli errori dei form, distinto dal rosso emergenza -->
    <color name="care_error">#FFB00020</color>
    <color name="care_on_error">#FFFFFFFF</color>

    <!-- stati richiesta: 5 tinte distinte, ognuna sempre con pallino + testo -->
    <!-- aperta = prugna -->
    <color name="stato_aperta_bg">#FFEEE1E8</color>
    <color name="stato_aperta_fg">#FF4A2140</color>

    <!-- presa in carico = pesca (in linea con l'accento) -->
    <color name="stato_incarico_bg">#FFF6DDD0</color>
    <color name="stato_incarico_fg">#FF9A4A2E</color>

    <!-- completata dal volontario (in attesa di conferma) = teal, distinto dalla pesca -->
    <color name="stato_attesa_bg">#FFD6EAF0</color>
    <color name="stato_attesa_fg">#FF17607F</color>

    <!-- confermata = verde -->
    <color name="stato_confermata_bg">#FFD7EFDA</color>
    <color name="stato_confermata_fg">#FF14652A</color>

    <!-- annullata = grigio caldo -->
    <color name="stato_annullata_bg">#FFEAE7DF</color>
    <color name="stato_annullata_fg">#FF5F5B54</color>
</resources>
