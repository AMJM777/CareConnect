<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Indaco istituzionale: barra superiore, azioni primarie, sezioni principali -->
