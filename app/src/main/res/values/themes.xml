<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.CareConnect" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Collegp la palette agli attributi Material -->
        <item name="colorPrimary">@color/care_primary</item>
        <item name="colorOnPrimary">@color/care_on_primary</item>
        <item name="colorPrimaryContainer">@color/care_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/care_primary_dark</item>

        <item name="colorSecondary">@color/care_accent</item>
        <item name="colorOnSecondary">@color/care_on_accent</item>

        <item name="colorError">@color/care_error</item>
        <item name="colorOnError">@color/care_on_error</item>

        <item name="android:colorBackground">@color/care_background</item>
        <item name="colorSurface">@color/care_surface</item>
        <item name="colorOnSurface">@color/care_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/care_on_surface_variant</item>
        <item name="colorOutline">@color/care_outline</item>

        <!-- FONT DELL'APP: Atkinson Hyperlegible su tutti i textview normali -->
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="fontFamily">@font/atkinson</item>

        <!-- FONT sui componenti material -->
        <item name="textAppearanceBodyLarge">@style/TextAppearance.CareConnect.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.CareConnect.BodyMedium</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.CareConnect.LabelLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.CareConnect.TitleMedium</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.CareConnect.TitleLarge</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.CareConnect.HeadlineSmall</item>
    </style>

    <style name="Theme.CareConnect" parent="Base.Theme.CareConnect" />

    <!-- Text appearance CareConnect: stessa dimensione/peso del corrispettivo
         Material3, ma con Atkinson Hyperlegible. -->
    <style name="TextAppearance.CareConnect.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:fontFamily">@font/atkinson</item>
    </style>
    <style name="TextAppearance.CareConnect.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:fontFamily">@font/atkinson</item>
    </style>
    <style name="TextAppearance.CareConnect.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.CareConnect.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.CareConnect.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.CareConnect.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Titoletto di sezione dentro le card: prugna, 17sp, grassetto  -->
    <style name="CareConnect.SectionLabel" parent="">
        <item name="android:textSize">@dimen/text_size_card_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/care_primary</item>
    </style>

    <!-- AZIONE PRIMARIA: fill prugna, testo bianco -->
    <style name="CareConnect.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/care_primary</item>
        <item name="android:textColor">@color/care_on_primary</item>
        <item name="iconTint">@color/care_on_primary</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textSize">@dimen/text_size_button</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

</resources>