<file path="app/src/main/res/navigation/nav_graph_auth.xml">
<?xml version="1.0" encoding="utf-8"?>
<!-- grafo annidato per il flusso di autenticazione con login, registrazione e completamento profilo -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_auth"
    app:startDestination="@id/loginFragment">

    <!-- schermata iniziale di accesso all'app -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.careconnect.ui.auth.LoginFragment"
        android:label=""
        tools:layout="@layout/fragment_login">

        <!-- azione per navigare verso la creazione di un nuovo account -->
        <action
            android:id="@+id/action_login_to_registrazione"
            app:destination="@id/registrazioneFragment" />

        <!-- azione per completare i dati dopo il primo login con account google -->
        <action
            android:id="@+id/action_login_to_completaProfiloGoogle"
            app:destination="@id/completaProfiloGoogleFragment" />

    </fragment>

    <!-- schermata per la registrazione classica tramite email e password -->
    <fragment
        android:id="@+id/registrazioneFragment"
        android:name="com.careconnect.ui.auth.RegistrazioneFragment"
        android:label="Registrati"
        tools:layout="@layout/fragment_registrazione">

        <!-- azione per tornare al login pulendo lo stack di navigazione in modo da non creare loop -->
        <action
            android:id="@+id/action_registrazione_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <!-- schermata per definire il ruolo al primo accesso con google, la navigazione in uscita è gestita via codice -->
    <fragment
        android:id="@+id/completaProfiloGoogleFragment"
        android:name="com.careconnect.ui.auth.CompletaProfiloGoogleFragment"
        android:label="Completa profilo"
        tools:layout="@layout/fragment_completa_profilo_google" />

</navigation>
</file>

<file path="app/src/main/res/navigation/nav_graph_familiare.xml">
<?xml version="1.0" encoding="utf-8"?>
<!-- grafo di navigazione interno per la sezione familiare con le destinazioni della bottom bar -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_familiare"
    app:startDestination="@id/attivitaFamiliareFragment">

    <!-- schermata iniziale: elenco delle richieste dell'anziano seguito, con conferma e valutazione -->
    <fragment
        android:id="@+id/attivitaFamiliareFragment"
