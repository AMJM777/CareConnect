<?xml version="1.0" encoding="utf-8"?>
<!-- contenitore radice per abilitare il data binding -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- contenitore principale della schermata con sfondo e margini standard -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/care_background"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding">

        <!-- banner rosso di emergenza nascosto di default -->
        <LinearLayout
            android:id="@+id/sosBanner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:orientation="vertical"
            android:background="@color/care_sos"
            android:padding="@dimen/spacing_medium"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- testo di avviso per l'allarme SOS lanciato dall'assistito -->
            <TextView
                android:id="@+id/sosText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Il tuo assistito ha lanciato un allarme SOS"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                android:textColor="@color/care_on_primary" />

            <!-- bottone testuale per confermare la presa visione e chiudere l'allarme -->
            <Button
                android:id="@+id/chiudiSosButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="Ho visto, chiudi"
                android:textColor="@color/care_on_primary" />

        </LinearLayout>

