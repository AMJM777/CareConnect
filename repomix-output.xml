<file path="app/src/main/res/layout/fragment_login.xml">
<?xml version="1.0" encoding="utf-8"?>
<!-- modulo con campi email, password, bottone di accesso standard e bottone per Google -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/care_background"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/screen_padding">

            <!-- Guideline al 10% dell'altezza: da qui parte il titolo, così il
                 blocco scende un po' in modo proporzionale (adattivo) -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/topGuideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.10" />

            <!-- Titolo in pagina (unico titolo: la barra blu del login è vuota) -->
            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_title"
                android:textSize="@dimen/text_size_title"
                android:textColor="@color/care_on_surface"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/topGuideline"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Campo email -->
            <EditText
                android:id="@+id/emailInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:hint="@string/login_email_hint"
                android:inputType="textEmailAddress"
                android:textSize="@dimen/text_size_body"
                android:autofillHints="emailAddress"
                app:layout_constraintTop_toBottomOf="@id/titleText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_large" />

            <!-- Campo password -->
            <EditText
                android:id="@+id/passwordInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:hint="@string/login_password_hint"
                android:inputType="textPassword"
                android:textSize="@dimen/text_size_body"
                android:autofillHints="password"
                app:layout_constraintTop_toBottomOf="@id/emailInput"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_medium" />

            <!-- Messaggio di errore, nascosto di default: visibilità gestita dal Fragment -->
            <TextView
                android:id="@+id/errorText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/care_error"
                android:textSize="@dimen/text_size_body"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/passwordInput"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_small"
                tools:text="Credenziali non valide"
                tools:visibility="visible" />

            <!-- Bottone login email/password -->
            <Button
                android:id="@+id/loginButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:text="@string/login_button"
                android:textSize="@dimen/text_size_button"
                android:backgroundTint="@color/care_accent"
                android:textColor="@color/care_on_primary"
                app:layout_constraintTop_toBottomOf="@id/errorText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_medium" />

            <!-- Bottone Google Sign-In -->
            <Button
                android:id="@+id/googleSignInButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:text="@string/login_google_button"
                android:textSize="@dimen/text_size_button"
                app:layout_constraintTop_toBottomOf="@id/loginButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_medium" />

            <!-- Link verso la registrazione -->
            <TextView
                android:id="@+id/goToRegisterText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_go_to_register"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/care_primary_dark"
                android:padding="@dimen/spacing_small"
                app:layout_constraintTop_toBottomOf="@id/googleSignInButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_medium"
                android:layout_marginBottom="@dimen/spacing_large" />

            <!-- Indicatore di caricamento, centrato sullo schermo -->
            <ProgressBar
                android:id="@+id/loadingIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
</file>

<file path="app/src/main/res/layout/fragment_profilo_familiare.xml">
<?xml version="1.0" encoding="utf-8"?>
<!-- contenitore radice obbligatorio per abilitare il data binding -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- collegamento con il viewmodel per popolare i dati dell'interfaccia dinamicamente -->
    <data>
        <variable
            name="viewModel"
            type="com.careconnect.viewmodel.familiare.ProfiloFamiliareViewModel" />
    </data>

    <!-- vista scorrevole per adattarsi a schermi di diverse dimensioni -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/care_background"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- immagine di profilo standard arrotondata per il familiare -->
            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_medium"
                android:background="@drawable/bg_avatar_circle"
                android:src="@drawable/ic_person"
                android:scaleType="fitCenter"
                android:padding="22dp"
                android:contentDescription="@null" />

            <!-- nome del familiare caricato dinamicamente dal viewmodel -->
            <TextView
                android:id="@+id/nomeFamiliareText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:gravity="center"
                android:text="@{viewModel.nomeFamiliareTesto}"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                android:textColor="@color/care_on_surface"
                tools:text="Sei collegato/a come: Marco" />

            <!-- etichetta visiva che identifica chiaramente il ruolo dell'utente -->
            <TextView
                style="@style/CareConnect.StatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="Familiare" />

            <!-- scheda riepilogativa del collegamento con l'assistito -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CareConnect.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Il tuo collegamento"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        android:textColor="@color/care_on_surface" />

                    <!-- nome dell'anziano seguito gestito in tempo reale dal viewmodel -->
                    <TextView
                        android:id="@+id/nomeAnzianoText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="@{viewModel.nomeAnzianoTesto}"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        android:textColor="@color/care_primary"
                        tools:text="Stai seguendo: Maria" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- bottone rosso di disconnessione dall'account -->
            <Button
                android:id="@+id/logoutButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_large"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:text="Esci"
                android:backgroundTint="@color/care_error"
                android:textColor="@color/care_on_error" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>
</layout>
</file>

