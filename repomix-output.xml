        R.id.ruoloAnzianoRadio -> UserRole.ANZIANO
        R.id.ruoloVolontarioRadio -> UserRole.VOLONTARIO
        R.id.ruoloFamiliareRadio -> UserRole.FAMILIARE
        else -> null
